{
  "manifest_version": 3,
  "name": "YT Transcript",
  "version": "1.0.0",
  "description": "Transcribe YouTube videos via Supadata and save locally.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "clipboardWrite",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://api.supadata.ai/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
